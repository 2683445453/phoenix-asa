<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PhoenixLicenseMode Condition="'$(PhoenixLicenseMode)'==''">Development</PhoenixLicenseMode>
    <PhoenixLicenseRoot>$(MSBuildThisFileDirectory)</PhoenixLicenseRoot>
    <PhoenixPublicKeyDirectory Condition="'$(PhoenixPublicKeyDirectory)'==''">$(PhoenixLicenseRoot)..\.local-license</PhoenixPublicKeyDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PhoenixLicenseMode)'=='Local'">
    <OutDir>$(ProjectDir)..\release\license-local\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(ProjectDir)x64\LicenseLocal\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(PhoenixLicenseRoot)client;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(PhoenixLicenseMode)'=='Local'">
    <ClCompile>
      <PreprocessorDefinitions>PHOENIX_LICENSE_ENABLED=1;PHOENIX_LICENSE_LOCAL=1;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(PhoenixPublicKeyDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <BufferSecurityCheck>true</BufferSecurityCheck>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(PhoenixLicenseMode)'=='Local'">
    <ClCompile Include="$(PhoenixLicenseRoot)client\LicenseClient.cpp" />
  </ItemGroup>
  <Target Name="ValidatePhoenixLicenseMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PhoenixLicenseMode)'!='Development' and '$(PhoenixLicenseMode)'!='Local'" Text="Unknown PhoenixLicenseMode. Only Development and Local are implemented; protected production publishing is not configured." />
    <Error Condition="'$(PhoenixLicenseMode)'=='Local' and ('$(Configuration)'!='Release' or '$(Platform)'!='x64')" Text="Local licensing requires Release|x64 and uses separate output directories." />
    <Error Condition="'$(PhoenixLicenseMode)'=='Local' and !Exists('$(PhoenixPublicKeyDirectory)\LicensePublicKey.h')" Text="Initialize the local license service before building. The public key is missing." />
  </Target>
</Project>
